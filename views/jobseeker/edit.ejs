<!DOCTYPE html>
<html lang="en">
<%-include('../common/head')%>
<body class="hold-transition sidebar-mini">
<div class="wrapper">
  <!-- Navbar -->
  <%-include('../common/navbar')%>
  <!-- /.navbar -->

  <!-- Main Sidebar Container -->
  <%-include('../common/sidebar')%>

  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1>Edit Job Seeker</h1>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
              <li class="breadcrumb-item"><a href="<%= generateUrl('jobSeeker-list')%>">Job Seeker</a></li>
              <li class="breadcrumb-item active">Edit Job Seeker</li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- Main content -->
    <section class="content">
      <div class="container-fluid">
        <div class="row">
          <div class="col-md-12">
            <div class="card card-success">
              <div class="card-header">
                <h3 class="card-title">Update Job Seeker Details</h3>
              </div>
              <!-- form start -->
              <form action="<%= generateUrl('jobSeeker-update', { id: data._id })%>" method="post" enctype="multipart/form-data">
                <div class="card-body">
                  <div class="form-group">
                    <label for="fullName">Full Name</label>
                    <input type="text" class="form-control" id="fullName" value="<%= data.name || '' %>" placeholder="Enter full name" name="name" minlength="3" maxlength="50" required>
                  </div>
                  <div class="form-group">
                    <label for="userEmail">Email address</label>
                    <input type="email" class="form-control" id="userEmail" value="<%= data.email || '' %>" placeholder="Enter email" name="email" required>
                  </div>
                  <div class="form-group">
                    <label for="userRole">Role</label>
                    <select class="form-control" id="userRole" name="role">
                      <option value="jobSeeker" <%= data.role === 'jobSeeker' ? 'selected' : '' %>>Job Seeker</option>
                      <option value="employer" <%= data.role === 'employer' ? 'selected' : '' %>>Employer</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label>Email Verification Status</label>
                    <div class="custom-control custom-checkbox">
                      <input type="checkbox" class="custom-control-input" id="isEmailVerified" name="isEmailVerified" value="true" <%= data.isEmailVerified ? 'checked' : '' %>>
                      <label class="custom-control-label" for="isEmailVerified">Verified Email Address</label>
                    </div>
                  </div>
                  <% if (data.image) { %>
                    <div class="form-group">
                      <label>Current Photo</label>
                      <div>
                        <img src="/<%= data.image.replace(/\\/g, '/') %>" alt="Profile" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd;" onerror="this.style.display='none'">
                      </div>
                    </div>
                  <% } %>
                  <div class="form-group">
                    <label for="profilePhoto">Change Photo</label>
                    <div class="input-group">
                      <div class="custom-file">
                        <input type="file" class="custom-file-input" id="profilePhoto" name="image">
                        <label class="custom-file-label" for="profilePhoto">Choose new file</label>
                      </div>
                    </div>
                  </div>
                </div>
                <!-- /.card-body -->

                <div class="card-footer">
                  <button type="submit" class="btn btn-success">Update Job Seeker</button>
                  <a href="<%= generateUrl('jobSeeker-list')%>" class="btn btn-default float-right">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <!-- /.content-wrapper -->
  <%-include('../common/footer')%>
</body>
</html>

