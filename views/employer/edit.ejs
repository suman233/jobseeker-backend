<!DOCTYPE html>
<html lang="en">
<%-include('../common/head')%>
<body class="hold-transition sidebar-mini">
<div class="wrapper">
  <!-- Navbar -->
  <%-include('../common/navbar')%>
  <!-- /.navbar -->

  <!-- Main Sidebar Container -->
  <%-include('../common/sidebar')%>

  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1>Edit Employer</h1>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
              <li class="breadcrumb-item"><a href="<%= generateUrl('employer-list')%>">Employer</a></li>
              <li class="breadcrumb-item active">Edit Employer</li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- Main content -->
    <section class="content">
      <div class="container-fluid">
        <div class="row">
          <div class="col-md-12">
            <div class="card card-success">
              <div class="card-header">
                <h3 class="card-title">Update Employer Details</h3>
              </div>
              <!-- form start -->
              <form action="<%= generateUrl('employer-update', { id: data._id })%>" method="post" enctype="multipart/form-data">
                <div class="card-body">
                  <div class="form-group">
                    <label for="fullName">Full Name</label>
                    <input type="text" class="form-control" id="fullName" value="<%= data.name || '' %>" placeholder="Enter full name" name="name" minlength="3" maxlength="50" required>
                  </div>
                  <div class="form-group">
                    <label for="userEmail">Email address</label>
                    <input type="email" class="form-control" id="userEmail" value="<%= data.email || '' %>" placeholder="Enter email" name="email" required>
                  </div>
                  <div class="form-group">
                    <label for="userRole">Role</label>
                    <select class="form-control" id="userRole" name="role">
                      <option value="employer" <%= data.role === 'employer' ? 'selected' : '' %>>Employer</option>
                      <option value="jobSeeker" <%= data.role === 'jobSeeker' ? 'selected' : '' %>>Job Seeker</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label>Email Verification Status</label>
                    <div class="custom-control custom-checkbox">
                      <input type="checkbox" class="custom-control-input" id="isEmailVerified" name="isEmailVerified" value="true" <%= data.isEmailVerified ? 'checked' : '' %>>
                      <label class="custom-control-label" for="isEmailVerified">Verified Email Address</label>
                    </div>
                  </div>

                  <div class="form-group">
                    <label for="profilePhoto">Profile Photo</label>
                    <div class="input-group">
                      <div class="custom-file">
                        <input type="file" class="custom-file-input" id="profilePhoto" name="image" accept="image/*">
                        <label class="custom-file-label" id="fileLabel" for="profilePhoto">Choose file to change photo</label>
                      </div>
                      <div class="input-group-append">
                        <span class="input-group-text">Upload</span>
                      </div>
                    </div>

                    <!-- Live Image Preview Below Input -->
                    <div id="imagePreviewContainer" class="mt-3">
                      <p class="text-muted text-sm font-weight-bold mb-1" id="previewLabel">
                        <%= data.image ? 'Current Photo:' : 'Photo Preview:' %>
                      </p>
                      <div class="p-1 border rounded d-inline-block bg-white shadow-sm">
                        <img
                          id="imagePreview"
                          src="<%= data.image ? '/' + data.image.replace(/\\/g, '/') : '#' %>"
                          alt="Profile Preview"
                          style="<%= data.image ? 'display:block;' : 'display:none;' %> width: 120px; height: 120px; object-fit: cover; border-radius: 6px;"
                          onerror="this.style.display='none'"
                        />
                      </div>
                    </div>
                  </div>
                </div>
                <!-- /.card-body -->

                <div class="card-footer">
                  <button type="submit" class="btn btn-success"><i class="fas fa-save mr-1"></i> Update Employer</button>
                  <a href="<%= generateUrl('employer-list')%>" class="btn btn-default float-right">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <!-- /.content-wrapper -->
  <%-include('../common/footer')%>
  <script>
    document.getElementById('profilePhoto')?.addEventListener('change', function(e) {
      const file = e.target.files && e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          const img = document.getElementById('imagePreview');
          const lbl = document.getElementById('previewLabel');
          if (img) {
            img.src = evt.target.result;
            img.style.display = 'block';
          }
          if (lbl) {
            lbl.innerText = 'New Photo to be Saved:';
          }
        };
        reader.readAsDataURL(file);
        const label = document.getElementById('fileLabel');
        if (label) label.innerText = file.name;
      }
    });
  </script>
</body>
</html>
