<!DOCTYPE html>
<html lang="en">
  <%-include('../common/head')%>
  <body class="hold-transition sidebar-mini">
    <div class="wrapper">
      <!-- Navbar -->
      <%-include('../common/navbar') %>
      <!-- /.navbar -->

      <!-- Main Sidebar Container -->
      <%-include('../common/sidebar')%>

      <!-- Content Wrapper. Contains page content -->
      <div class="content-wrapper">
        <!-- Content Header (Page header) -->
        <section class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6">
                <h1>Employer</h1>
              </div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                  <li class="breadcrumb-item"><a href="#">Home</a></li>
                  <li class="breadcrumb-item active">Employer</li>
                </ol>
              </div>
            </div>
          </div>
        </section>

        <!-- Main content -->
        <section class="content">
          <div class="container-fluid">
            <div class="row">
              <div class="col-12">
                <div class="card">
                  <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">Employer List</h3>
                    <a href="<%= generateUrl('employer-add')%>" class="btn btn-info ms-auto"><i class="fas fa-plus mr-1"></i> Add Employer</a>
                  </div>
                  <!-- /.card-header -->
                  <div class="card-body">
                    <table
                      id="example2"
                      class="table table-bordered table-hover"
                    >
                      <thead>
                        <tr>
                          <th>Sl. No.</th>
                          <th>Name</th>
                          <th>Email</th>
                          <th>Role</th>
                          <th>Status</th>
                          <th>Registered</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% let serialNo = 1; %>
                        <% for (let item of data) { %>
                          <tr>
                            <td><%= serialNo %></td>
                            <td>
                              <div class="d-flex align-items-center">
                                <% if (item.image) { %>
                                  <img src="<%= getImageUrl(item.image) %>" alt="" style="width: 32px; height: 32px; object-fit: cover; border-radius: 50%; margin-right: 8px; border: 1px solid #dee2e6;" onerror="this.style.display='none'">
                                <% } %>
                                <strong><%= item.name %></strong>
                              </div>
                            </td>
                            <td><%= item.email %></td>
                            <td><span class="badge badge-primary"><%= item.role ? (item.role.charAt(0).toUpperCase() + item.role.slice(1)) : 'Employer' %></span></td>
                            <td>
                              <% if (item.isEmailVerified) { %>
                                <span class="badge badge-success" style="background-color: #28a745; color: #fff; padding: 5px 8px; border-radius: 4px;">Verified</span>
                              <% } else { %>
                                <span class="badge badge-warning" style="background-color: #ffc107; color: #000; padding: 5px 8px; border-radius: 4px;">Pending OTP</span>
                              <% } %>
                            </td>
                            <td><%= item.createdAt ? new Date(item.createdAt).toLocaleDateString() : 'N/A' %></td>
                            <td>
                              <a
                                href="<%= generateUrl('employer-edit', { id: item._id }) %>"
                                class="btn btn-sm btn-success"
                                ><i class="fas fa-edit mr-1"></i> Update</a
                              >
                              <a
                                href="<%= generateUrl('employer-delete', { id: item._id }) %>"
                                class="btn btn-sm btn-danger ml-1"
                                onclick="return confirm('Are you sure you want to delete this employer?');"
                                ><i class="fas fa-trash mr-1"></i> Delete</a
                              >
                            </td>
                          </tr>
                          <% serialNo++; %>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                  <!-- /.card-body -->
                </div>
                <!-- /.card -->
              </div>
              <!-- /.col -->
            </div>
            <!-- /.row -->
          </div>
          <!-- /.container-fluid -->
        </section>
        <!-- /.content -->
      </div>
      <!-- /.content-wrapper -->
      <%-include('../common/footer')%>
    </div>
  </body>
</html>
