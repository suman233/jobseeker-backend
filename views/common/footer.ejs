<script>
  (function () {
    const messages = {
      "user-created": ["success", "User created and credentials emailed."],
      duplicate: ["error", "An account with that email already exists."],
      invalid: ["error", "Enter a valid name, email, and user type."],
      "mail-failed": ["error", "Could not send the credentials email; the account was not saved."],
      failed: ["error", "Could not create the user. Please try again."],
      "login-success": ["success", "Signed in successfully."]
    };
    const query = new URLSearchParams(window.location.search);
    const notice = messages[query.get("toast")];
    if (notice) {
      toastr[notice[0]](notice[1]);
      query.delete("toast");
      const suffix = query.toString();
      window.history.replaceState({}, "", window.location.pathname + (suffix ? "?" + suffix : ""));
    }
  })();
  $(function () {
    $("#example1")
      .DataTable({
        responsive: true,
        lengthChange: false,
        autoWidth: false,
        buttons: ["copy", "csv", "excel", "pdf", "print", "colvis"],
      })
      .buttons()
      .container()
      .appendTo("#example1_wrapper .col-md-6:eq(0)");
    $("#example2").DataTable({
      paging: true,
      lengthChange: false,
      searching: false,
      ordering: true,
      info: true,
      autoWidth: false,
      responsive: true,
    });
  });
</script>
