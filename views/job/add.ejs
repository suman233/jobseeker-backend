<!DOCTYPE html>
<html lang="en">
<%-include('../common/head')%>
<body class="hold-transition sidebar-mini">
<div class="wrapper">
  <!-- Navbar -->
  <%-include('../common/navbar')%>
  <!-- /.navbar -->

  <!-- Main Sidebar Container -->
  <%-include('../common/sidebar')%>

  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1>Post New Job</h1>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
              <li class="breadcrumb-item"><a href="<%= generateUrl('job-list')%>">Jobs</a></li>
              <li class="breadcrumb-item active">Post Job</li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- Main content -->
    <section class="content">
      <div class="container-fluid">
        <div class="row">
          <div class="col-md-12">
            <div class="card card-primary">
              <div class="card-header">
                <h3 class="card-title">Job Details</h3>
              </div>
              <!-- form start -->
              <form action="<%= generateUrl('job-create')%>" method="post" enctype="multipart/form-data">
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-6 form-group">
                      <label for="jobTitle">Job Title *</label>
                      <input type="text" class="form-control" id="jobTitle" name="title" placeholder="e.g. Senior Product Designer - Design Systems" required>
                    </div>
                    <div class="col-md-6 form-group">
                      <label for="companyName">Company Name *</label>
                      <input type="text" class="form-control" id="companyName" name="company" placeholder="e.g. Stripe" required>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-6 form-group">
                      <label for="jobLocation">Location *</label>
                      <input type="text" class="form-control" id="jobLocation" name="location" placeholder="e.g. San Francisco, CA or Remote" value="San Francisco, CA or Remote" required>
                    </div>
                    <div class="col-md-3 form-group">
                      <label for="workplaceType">Workplace Type</label>
                      <select class="form-control" id="workplaceType" name="workplaceType">
                        <option value="Remote">Remote</option>
                        <option value="Hybrid">Hybrid</option>
                        <option value="On-site">On-site</option>
                      </select>
                    </div>
                    <div class="col-md-3 form-group">
                      <label for="jobType">Employment Type</label>
                      <select class="form-control" id="jobType" name="jobType">
                        <option value="Full-time">Full-time</option>
                        <option value="Part-time">Part-time</option>
                        <option value="Contract">Contract</option>
                        <option value="Internship">Internship</option>
                      </select>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-4 form-group">
                      <label for="category">Category</label>
                      <input type="text" class="form-control" id="category" name="category" placeholder="e.g. Product & Engineering" value="Product & Engineering">
                    </div>
                    <div class="col-md-4 form-group">
                      <label for="experienceLevel">Experience Level</label>
                      <select class="form-control" id="experienceLevel" name="experienceLevel">
                        <option value="Senior">Senior</option>
                        <option value="Mid-level">Mid-level</option>
                        <option value="Lead">Lead</option>
                        <option value="Director">Director</option>
                        <option value="Entry">Entry</option>
                      </select>
                    </div>
                    <div class="col-md-4 form-group">
                      <label for="status">Listing Status</label>
                      <select class="form-control" id="status" name="status">
                        <option value="active">Active</option>
                        <option value="draft">Draft</option>
                        <option value="closed">Closed</option>
                      </select>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-4 form-group">
                      <label for="minSalary">Min Base Salary ($/yr)</label>
                      <input type="number" class="form-control" id="minSalary" name="minSalary" placeholder="190000" value="190000">
                    </div>
                    <div class="col-md-4 form-group">
                      <label for="maxSalary">Max Base Salary ($/yr)</label>
                      <input type="number" class="form-control" id="maxSalary" name="maxSalary" placeholder="245000" value="245000">
                    </div>
                    <div class="col-md-4 form-group">
                      <label for="salaryText">Salary Display Text</label>
                      <input type="text" class="form-control" id="salaryText" name="salaryText" placeholder="e.g. $190k - $245k / year + Significant Equity" value="$190,000 - $245,000 / year + Significant Equity">
                    </div>
                  </div>

                  <div class="form-group">
                    <label for="description">About the Role / Overview *</label>
                    <textarea class="form-control" id="description" name="description" rows="4" placeholder="Describe the responsibilities, team, and impact of the role..." required>At Stripe, we are building the economic infrastructure for the internet. The Design Systems team provides the architectural foundation powering every merchant surface, global checkout flow, and developer experience worldwide.</textarea>
                  </div>

                  <div class="form-group">
                    <label for="requirements">Key Responsibilities & Qualifications (One per line)</label>
                    <textarea class="form-control" id="requirements" name="requirements" rows="4" placeholder="Enter qualifications, one per line...">5+ years architecting enterprise-grade design systems with cross-functional adoption across global engineering organizations.
Deep mastery of Figma component libraries, multi-brand token workflows, variables, and automated asset pipelines.
Working fluency in React, TypeScript, and modern CSS architecture to collaborate directly in GitHub Pull Requests.
Uncompromising commitment to digital accessibility standards (WCAG AAA) and international localization nuances.</textarea>
                  </div>

                  <div class="form-group">
                    <label for="skills">Skills & Tags (Comma separated)</label>
                    <input type="text" class="form-control" id="skills" name="skills" placeholder="e.g. Figma, React, Design Systems, TypeScript" value="Figma, React, Design Systems, TypeScript, UI/UX">
                  </div>

                  <div class="row">
                    <div class="col-md-6 form-group">
                      <label for="hiringManagerName">Hiring Manager Name</label>
                      <input type="text" class="form-control" id="hiringManagerName" name="hiringManagerName" placeholder="e.g. Elena Rostova" value="Elena Rostova">
                    </div>
                    <div class="col-md-6 form-group">
                      <label for="hiringManagerRole">Hiring Manager Role</label>
                      <input type="text" class="form-control" id="hiringManagerRole" name="hiringManagerRole" placeholder="e.g. VP of Platform Design" value="VP of Platform Design">
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-6 form-group">
                      <label for="companyLogo">Company Logo (Optional)</label>
                      <div class="input-group">
                        <div class="custom-file">
                          <input type="file" class="custom-file-input" id="companyLogo" name="companyLogo">
                          <label class="custom-file-label" for="companyLogo">Choose logo</label>
                        </div>
                      </div>
                    </div>
                    <div class="col-md-6 form-group d-flex align-items-center pt-4">
                      <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="isFeatured" name="isFeatured" value="true">
                        <label class="custom-control-label" for="isFeatured">Mark as Featured Opportunity</label>
                      </div>
                    </div>
                  </div>
                </div>
                <!-- /.card-body -->

                <div class="card-footer">
                  <button type="submit" class="btn btn-primary"><i class="fas fa-check mr-1"></i> Post Job</button>
                  <a href="<%= generateUrl('job-list')%>" class="btn btn-default float-right">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <!-- /.content-wrapper -->
  <%-include('../common/footer')%>
</body>
</html>
