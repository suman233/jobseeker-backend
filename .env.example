# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES TEMPLATE (RENDER DEPLOYMENT GUIDE)
# ==============================================================================
# In Render Dashboard -> Environment: Add these Key/Value pairs:
# 1. MONGO_URL
# 2. JWT_ACCESS_TOKEN_SECRET_KEY
# 3. SESSION_SECRET
# 4. FRONTEND_HOST (Set to your Vercel deployment URL, e.g. https://your-frontend.vercel.app)
# 5. NODE_ENV=production
# (Note: PORT is automatically assigned by Render, no need to manually specify PORT on Render)
# ==============================================================================

# Database Connection (MongoDB Atlas connection string)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/jobCrud

# Application Environment
NODE_ENV=production
HOST=0.0.0.0
PORT=3002
APP_NAME=jobseekerBackend
API_FOLDER_NAME=api
ADMIN_FOLDER_NAME=admin
SHOW_NAMED_ROUTES=false

# Security Secrets (Generate random 64-char strings for production)
JWT_ACCESS_TOKEN_SECRET_KEY=your_jwt_secret_key_here
SESSION_SECRET=your_express_session_secret_here

# Frontend URL for CORS (Point to your Vercel app in production)
FRONTEND_HOST=https://your-frontend.vercel.app

# Email Service Credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com

